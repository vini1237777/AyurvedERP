{
  "name": "erp-server",
  "version": "1.0.0",
  "description": "ERP Backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "UV_THREADPOOL_SIZE=16 nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "UV_THREADPOOL_SIZE=16 node dist/app.js",
    "start:cluster": "UV_THREADPOOL_SIZE=16 node dist/cluster.js",
    "benchmark:reports": "ts-node src/scripts/report-benchmark.ts",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "bootstrap": "ts-node prisma/bootstrap.ts",
    "backfill:ledger": "ts-node prisma/backfill-ledger.ts",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node --loader ts-node/esm prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && tsc"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.37",
    "nodemon": "^3.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
